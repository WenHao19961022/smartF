<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartfridge.mapper.SysUserMapper">

    <select id="getByOpenid" resultType="com.smartfridge.entity.SysUser">
        SELECT * FROM sys_user WHERE openid = #{openid} LIMIT 1
    </select>

    <select id="getSendEmailUserList" resultType="com.smartfridge.entity.SysUser">
        SELECT * FROM sys_user
        WHERE push_enabled = 1 AND email IS NOT NULL AND email != ''
        ORDER BY id
    </select>

</mapper>