page {
  background-color: #F8F9FA;
  min-height: 100vh;
}

/* 搜索框容器 */
.search-bar-wrap {
  padding: 10rpx 0;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.list-hint {
  padding: 30rpx 40rpx 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 列表条目容器 - 核心布局修改 */
.device-item {
  display: flex;
  align-items: center;
  padding: 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f2f2f2;
  transition: all 0.2s;
}

/* 选中状态：使用你要求的高饱和绿色背景淡化版 */
.item-selected {
  background-color: rgba(39, 174, 96, 0.05);
  border-left: 8rpx solid #27ae60;
}

/* 左侧图标区域 */
.device-icon-box {
  width: 80rpx;
  height: 100rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.fridge-icon {
  width: 100%;
  height: 100%;
}

/* 中间文字区域 */
.device-content {
  flex: 1;
}

.device-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.device-sub {
  font-size: 24rpx;
  color: #999;
}

/* 右侧状态 */
.device-status {
  font-size: 26rpx;
  color: #bbb;
  margin-left: 20rpx;
}

/* 底部按钮 */
.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 60rpx 80rpx;
  background-color: #fff;
  box-shadow: 0 -5rpx 20rpx rgba(0,0,0,0.05);
}

/* 高饱和度绿色按钮 */
.green-confirm-btn {
  background: linear-gradient(135deg, #a7eec0 0%, #27ae60 100%) !important;
  color: #fff !important;
  border: none !important;
  font-weight: bold !important;
  height: 90rpx !important;
  box-shadow: 0 10rpx 25rpx rgba(39, 174, 96, 0.3);
}