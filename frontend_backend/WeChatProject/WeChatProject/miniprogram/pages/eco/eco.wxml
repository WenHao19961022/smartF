<view class="page-container">
  <view class="header">
    <text class="title">您的 ESG 环保贡献</text>
    <text class="subtitle">每一次及时消耗，都是对地球的拯救</text>
  </view>

  <view class="glass-box dashboard">
    <view class="data-item">
      <view class="data-val">
        <text class="num">1.2</text>
        <text class="unit">kg</text>
      </view>
      <view class="data-label">累计拯救食物</view>
    </view>
    
    <view class="divider"></view>
    
    <view class="data-item">
      <view class="data-val">
        <text class="num">3.4</text>
        <text class="unit">kg</text>
      </view>
      <view class="data-label">减少 CO₂ 排放</view>
    </view>
    
    <view class="divider"></view>
    
    <view class="data-item">
      <view class="data-val">
        <text class="num">45</text>
        <text class="unit">L</text>
      </view>
      <view class="data-label">节约水资源</view>
    </view>
  </view>

  <view class="glass-box tree-card">
    <view class="tree-header">
      <view class="tree-title">我的鲜果树</view>
      <view class="tree-level">Lv. 3 茂盛</view>
    </view>
    <view class="tree-visual">
      <view class="circle-bg">
        <van-icon name="flower-o" size="80px" color="#27ae60" />
      </view>
      <text class="tree-desc">再拯救 3 个临期水果即可升级！</text>
    </view>
    <van-progress 
      percentage="75" 
      stroke-width="10px" 
      color="linear-gradient(to right, #a8e063, #56ab2f)" 
      show-pivot="{{false}}" 
    />
  </view>

  <view class="section-title">本周拯救记录</view>
  <view class="glass-box log-card">
    <view class="log-item">
      <van-icon name="passed" color="#27ae60" size="20px" />
      <text class="log-text">成功在过期前消耗了 2 个苹果</text>
      <text class="log-time">昨天</text>
    </view>
    <view class="log-item">
      <van-icon name="passed" color="#27ae60" size="20px" />
      <text class="log-text">成功在过期前消耗了 1 盒草莓</text>
      <text class="log-time">周一</text>
    </view>
  </view>
</view>