.page-container { padding: 30rpx; background: linear-gradient(180deg, #d9eff7 0%, #eef7f9 50%, #f4f6f3 100%); min-height: 100vh; box-sizing: border-box; }
.header { text-align: center; margin: 20rpx 0 40rpx; }
.title { font-size: 42rpx; font-weight: bold; color: #1e293b; display: block; margin-bottom: 10rpx; }
.subtitle { font-size: 26rpx; color: #64748b; }

.glass-box { background: rgba(255, 255, 255, 0.45); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.6); border-radius: 40rpx; padding: 40rpx; margin-bottom: 30rpx; box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03); }

.dashboard { display: flex; justify-content: space-between; align-items: center; padding: 50rpx 20rpx; }
.data-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.data-val { display: flex; align-items: baseline; color: #27ae60; }
.num { font-size: 56rpx; font-weight: bold; }
.unit { font-size: 24rpx; margin-left: 6rpx; }
.data-label { font-size: 22rpx; color: #64748b; margin-top: 15rpx; }
.divider { width: 2rpx; height: 60rpx; background: rgba(0,0,0,0.1); }

.tree-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.tree-title { font-size: 32rpx; font-weight: bold; color: #333; }
.tree-level { font-size: 24rpx; color: #fff; background: #27ae60; padding: 4rpx 16rpx; border-radius: 20rpx; }
.tree-visual { display: flex; flex-direction: column; align-items: center; margin: 40rpx 0; }
.circle-bg { width: 200rpx; height: 200rpx; background: rgba(255,255,255,0.6); border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 40rpx rgba(39, 174, 96, 0.2); }
.tree-desc { font-size: 24rpx; color: #64748b; margin-top: 30rpx; }

.section-title { font-size: 34rpx; font-weight: bold; margin: 40rpx 10rpx 20rpx; color: #333; }
.log-item { display: flex; align-items: center; margin-bottom: 25rpx; padding-bottom: 25rpx; border-bottom: 1px dashed rgba(0,0,0,0.05); }
.log-item:last-child { margin-bottom: 0; border-bottom: none; padding-bottom: 0; }
.log-text { flex: 1; font-size: 26rpx; color: #475569; margin-left: 20rpx; }
.log-time { font-size: 22rpx; color: #94a3b8; }