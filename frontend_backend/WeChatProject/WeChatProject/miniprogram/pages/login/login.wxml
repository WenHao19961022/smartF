<view class="login-page">
  <!-- 1. 欢迎标题 -->
  <view class="login-welcome">
    <view class="title">登录开启智慧生活</view>
  </view>
  
  <!-- 2. 登录按钮区域 -->
  <view class="btn-wrap">
    <van-button 
      block 
      round 
      bindtap="handleWxLogin" 
      custom-class="green-login-btn"
    >
      一键登录
    </van-button>
  </view>

  <!-- 3. 底部隐私协议 (修复对齐问题) -->
  <view class="protocol-section">
    <checkbox-group bindchange="onAgree">
      <checkbox value="ok" color="#27ae60" class="custom-checkbox" />
    </checkbox-group>
    <view class="protocol-text">
      勾选代表您已同意 <text class="link">《隐私政策》</text> 和 <text class="link">《服务协议》</text>
    </view>
  </view>
</view>