/* 全局背景：蓝绿渐变 */
.page-container {
  padding: 30rpx;
  background: linear-gradient(180deg, #d9eff7 0%, #eef7f9 50%, #f4f6f3 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 玻璃拟态卡片核心样式 */
.glass-box {
  background: rgba(255, 255, 255, 0.5) !important;
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  padding: 20rpx 10rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

/* 顶部用户信息 */
.user-header-v3 {
  display: flex;
  align-items: center;
  padding: 60rpx 20rpx 40rpx;
}

.avatar-wrap {
  width: 130rpx;
  height: 130rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
}

.user-text {
  display: flex;
  align-items: center;
}

.name {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

/* 栏目标题 */
.section-label {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin: 0 10rpx 20rpx;
}

/* 硬件状态页脚 */
.status-footer {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  margin-top: 10rpx;
}

.status-text {
  font-size: 24rpx;
  color: #666;
}

/* 呼吸灯 */
.dot {
  width: 14rpx;
  height: 14rpx;
  background: #ccc;
  border-radius: 50%;
  margin-right: 15rpx;
}

.dot.pulse {
  background: #27ae60;
  animation: pulse-kf 2s infinite;
}

@keyframes pulse-kf {
  0% { box-shadow: 0 0 0 0 rgba(39, 174, 96, 0.7); }
  70% { box-shadow: 0 0 0 12rpx rgba(39, 174, 96, 0); }
  100% { box-shadow: 0 0 0 0 rgba(39, 174, 96, 0); }
}

/* 退出按钮 */
.logout-btn {
  text-align: center;
  color: #eb2f06;
  font-size: 28rpx;
  margin-top: 80rpx;
  padding: 30rpx;
  font-weight: 500;
}

/* 覆盖 Vant 内部背景，保持磨砂透明感 */
.van-cell {
  background-color: transparent !important;
  color: #444 !important;
  padding: 30rpx 30rpx !important;
}

.van-cell__title {
  font-size: 30rpx;
}